% Layout of Laga & Vanhulle (2025), "Atmospheric Composition of Sub-Neptune
% Exoplanets under Magma-Envelope Coupling" (KU Leuven bachelor thesis),
% reconstructed from that PDF: 11 pt Palatino, two columns with 1.2 cm
% margins, chapters that do not start a new page, italic captions with a bold
% lead sentence, red internal links and green citations.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesisstyle}[2026/10/29 Laga-Vanhulle thesis layout]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathpazo}             % URW Palladio text, PazoMath (as the thesis)
\RequirePackage{helvet}  % Nimbus Sans on the title page
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs,array,tabularx}
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
\RequirePackage{microtype}
\RequirePackage[a4paper,left=1.2cm,right=1.2cm,top=2.0cm,bottom=1.65cm,
  headheight=14pt,headsep=24pt,footskip=25pt,columnsep=24pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage[explicit]{titlesec}
\RequirePackage{titletoc}
\RequirePackage[font={small,it},labelfont={bf,up},labelsep=colon,
  justification=justified,singlelinecheck=false,skip=6pt]{caption}
\RequirePackage[font={small,it},labelfont={bf,up},labelformat=parens]{subcaption}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage[colorlinks=true,linkcolor=red,citecolor=green,urlcolor=magenta,
  bookmarksnumbered=true]{hyperref}

\newcommand{\thesisauthors}{}
% Table bodies are generated files; the TeX primitive keeps \bottomrule legal after them.
\newcommand{\inputtable}[1]{\@@input #1 }
\newcommand{\Atm}{Atmodeller}

% ------------------------------------------------------------------ headings
% Chapters run on (no page break), as in the thesis: "1. Introduction".
\titleclass{\chapter}{straight}
\titleformat{\chapter}[block]{\centering\bfseries\LARGE}{}{0pt}%
  {\ifnum\value{chapter}>0\relax\thechapter.\ \fi#1}
\titleformat{name=\chapter,numberless}[block]{\centering\bfseries\LARGE}{}{0pt}{#1}
\titlespacing*{\chapter}{0pt}{14pt}{10pt}
\titleformat{\section}{\bfseries\large\raggedright}{\thesection}{1em}{#1}
\titlespacing*{\section}{0pt}{18pt plus 4pt minus 2pt}{10pt plus 2pt}
\titleformat{\subsection}{\itshape\normalsize\raggedright}{\thesubsection}{1em}{#1}
\titlespacing*{\subsection}{0pt}{10pt plus 3pt minus 2pt}{4pt plus 2pt}
\titleformat{\paragraph}[runin]{\bfseries}{}{0pt}{#1}
\titlespacing*{\paragraph}{0pt}{6pt plus 2pt}{0.5em}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{1}

% ------------------------------------------------------------------ page style
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\leftmark}
\fancyhead[R]{\thesisauthors}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{%
  \markboth{\MakeUppercase{\ifnum\value{chapter}>0\relax
    \ifappendixmode APPENDIX\else CHAPTER\fi\ \thechapter.\ \fi#1}}{}}
\newif\ifappendixmode
\fancypagestyle{frontmatter}{\fancyhf{}\fancyfoot[R]{\textbf{\thepage}}%
  \renewcommand{\headrulewidth}{0pt}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}}

% ------------------------------------------------------------------ captions, floats
% Bold lead sentence in the caption; the lists of figures and tables show only it.
\newcommand{\thesiscaption}[2]{\caption[#1]{\textbf{#1} #2}}
\setlength{\abovecaptionskip}{6pt}
\setlength{\textfloatsep}{12pt plus 2pt minus 2pt}
\setlength{\floatsep}{10pt plus 2pt minus 2pt}
\setlength{\intextsep}{10pt plus 2pt minus 2pt}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.8}
\renewcommand{\dbltopfraction}{0.9}
\renewcommand{\dblfloatpagefraction}{0.8}
\setcounter{topnumber}{3}
\setcounter{dbltopnumber}{3}
\setlist{itemsep=1pt,topsep=4pt,parsep=0pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% ------------------------------------------------------------------ front matter
% Front-matter pages are one column with a 14 cm measure, page numbers bottom right.
\newcommand{\frontmattertitle}[1]{%
  \begingroup\centering\bfseries\LARGE #1\par\endgroup\vspace{12pt}}
\newenvironment{frontpage}{%
  \newgeometry{onecolumn,left=3.0cm,right=3.0cm,top=2.6cm,bottom=2.2cm,footskip=25pt}%
  \onecolumn\thispagestyle{frontmatter}\pagestyle{frontmatter}}{%
  \clearpage\restoregeometry}
% Narrow italic block used for the preface and abstracts (12 cm).
\newenvironment{narrowtext}{\par\begin{list}{}{\leftmargin=1.0cm\rightmargin=1.0cm}%
  \item\relax\itshape}{\end{list}}

% Lists of figures/tables as one page, with "List of Figures" subheadings.
\titlecontents{figure}[2.2em]{\vspace{1pt}}{\contentslabel{2.2em}}{}%
  {\titlerule*[0.6pc]{.}\contentspage}
\titlecontents{table}[2.2em]{\vspace{1pt}}{\contentslabel{2.2em}}{}%
  {\titlerule*[0.6pc]{.}\contentspage}
\titlecontents{chapter}[1.5em]{\addvspace{6pt}\bfseries}{\contentslabel{1.5em}}{}%
  {\hfill\contentspage}
\titlecontents{section}[3.8em]{\vspace{1pt}}{\contentslabel{2.3em}}{}%
  {\titlerule*[0.6pc]{.}\contentspage}

\endinput
